# Used by `npm run build` (and therefore `npm run deploy`).
# Overrides .env, which holds the localhost value for `npm start`.
# Must match the redirect URI registered in the Zoho API console exactly,
# and the `homepage` field in package.json.
# Not a secret - this value is visible in the OAuth URL.
VITE_REDIRECT_URI="https://laxmihandloom.github.io/Large-Barcode-Printer/"
